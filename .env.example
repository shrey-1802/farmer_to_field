# KrishiNirnay AI — Environment Variables
# Copy this file to .env (backend/) and fill in your values.
# Do NOT commit your .env file. It is listed in .gitignore.
# The frontend backend URL is NOT a secret and can be committed.

# ─── FastAPI / Database ────────────────────────────────────────────────────────

# PostgreSQL connection string (Render or local)
DATABASE_URL=postgresql://user:password@localhost:5432/krishinirnay

# Secret key for JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# JWT token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── OTP Service ──────────────────────────────────────────────────────────────

# SMS OTP provider — set to "mock" for development (accepts any OTP)
OTP_PROVIDER=mock

# Twilio credentials (if OTP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Fast2SMS credentials (if OTP_PROVIDER=fast2sms)
# FAST2SMS_API_KEY=

# ─── AI / LLM ─────────────────────────────────────────────────────────────────

# Google Gemini API key (for AI agent reasoning)
# NEVER expose this in the frontend. Backend only.
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key (optional alternative)
# OPENAI_API_KEY=

# ─── Weather ──────────────────────────────────────────────────────────────────

# Open-Meteo is free and requires no API key.
# Override the base URL only if using a self-hosted instance.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Virtual IoT Engine ───────────────────────────────────────────────────────

# Enable virtual sensor simulation (true in dev/demo, false in production with real hardware)
ENABLE_VIRTUAL_IOT=true

# Sensor polling interval in seconds
SENSOR_POLL_INTERVAL_SECONDS=10

# ─── Application ──────────────────────────────────────────────────────────────

# Environment: development | staging | production
APP_ENV=development

# Allow CORS from these origins (comma-separated)
# In production, set to your GitHub Pages URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shrey-1802.github.io

# Render.com sets PORT automatically — do not override in production
# PORT=8000

# ─── Frontend Config (for reference — set in frontend/js/config.js) ───────────

# These are NOT secrets. They are committed to the repo in config.js.
# API_BASE_URL=https://krishinirnay-api.onrender.com/api
# ENABLE_DEMO_MODE=false
