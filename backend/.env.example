# KrishiNirnay AI - Environment Configuration

APP_NAME=KrishiNirnay AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (Leave empty or sqlite for default local development)
DATABASE_URL=
DB_ECHO=false

# Cache / Redis (Optional for local development; fallback in-memory is supported)
REDIS_URL=

# Security & Authentication
JWT_SECRET=super-secret-krishinirnay-jwt-token-change-in-production-0987654321
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend CORS Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://shrey-1802.github.io
FRONTEND_PRODUCTION_ORIGIN=https://shrey-1802.github.io

# Weather Provider
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=1800

# Optional LLM Integration (Fallback to deterministic rules if empty)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Simulation Mode
SIMULATION_MODE=true

# Logging
LOG_LEVEL=INFO
