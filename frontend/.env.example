# KrishiNirnay AI Frontend Configuration Example
# Copy or reference these values in your deployment or window.APP_CONFIG

# Backend FastAPI URL on Render (Production)
VITE_API_BASE_URL=https://krishinirnay-api.onrender.com/api

# Local Development Backend URL
# VITE_API_BASE_URL=http://localhost:8000/api

# Environment Mode: 'production' | 'development' | 'demo'
APP_ENV=production

# Polling and Telemetry Rates (in milliseconds)
SENSOR_POLL_INTERVAL_MS=10000
WEATHER_POLL_INTERVAL_MS=300000

# Virtual IoT Simulated Sensor Toggle (true to show SIMULATED badges)
ENABLE_VIRTUAL_IOT=true

# Demo fallback when backend service is sleeping on Render free-tier
ENABLE_MOCK_FALLBACK=true
